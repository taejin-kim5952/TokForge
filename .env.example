# TokForge 환경변수 예시. 실제 운영 시 .env 로 복사 후 값 채움.
# .env 는 .gitignore 에 포함되어야 함.

# Ollama (기본값: localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Step 9 — Langfuse Cloud (또는 self-host)
# 1) https://cloud.langfuse.com 가입
# 2) 프로젝트 생성 → Settings → API Keys
# 3) 아래 값들 발급받아 복사
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# self-host 시: LANGFUSE_HOST=http://localhost:3000
